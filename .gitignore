# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# electron
/electron/dist
/electron/node_modules

# misc
.DS_Store
*.pem
.idea
.worktrees
*.iml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# docs site (website/)
website/.venv/
website/**/site/
website/**/.cache/
# uv.lock pins Zensical for CI; re-include it in case a global ignore matches *.lock
!website/uv.lock
